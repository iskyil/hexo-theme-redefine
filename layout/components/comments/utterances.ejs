<% const utterancesConfig = theme.comment.config?.utterances || {}; %>
<% if (theme.comment.system === 'utterances' && utterancesConfig.repo) { %>
    <%
      const hasIssueNumber =
        utterancesConfig.issue_number !== undefined &&
        utterancesConfig.issue_number !== null &&
        utterancesConfig.issue_number !== '';
    %>
    <div class="utterances-container min-h-16" data-utterances data-comment-provider="utterances"
         data-utterances-src="https://utteranc.es/client.js"
         data-utterances-repo="<%= utterancesConfig.repo %>"
         data-utterances-issue-term="<%= utterancesConfig.issue_term || 'pathname' %>"
         data-utterances-issue-number="<%= hasIssueNumber ? utterancesConfig.issue_number : '' %>"
         data-utterances-label="<%= utterancesConfig.label ?? '' %>"
         data-utterances-theme-light="<%= utterancesConfig.theme_light || 'github-light' %>"
         data-utterances-theme-dark="<%= utterancesConfig.theme_dark || 'github-dark' %>">
        <p data-comment-status role="status" aria-live="polite"><%= __('comments_loading') %></p>
        <button type="button" data-comment-retry hidden class="my-2 rounded-lg border border-rd-gray-alpha-400 px-4 py-2"><%= __('comments_retry') %></button>
        <div data-comment-mount><div id="utterances-container"></div></div>
    </div>
<% } %>
