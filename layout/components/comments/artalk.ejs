<% const artalkConfig = theme.comment.config?.artalk || {}; %>
<% if (
  theme.comment.system === 'artalk' &&
  artalkConfig.server &&
  artalkConfig.site
) { %>
    <div class="artalk-container min-h-16" data-artalk data-comment-provider="artalk"
         data-artalk-src="https://cdn.jsdelivr.net/npm/artalk/dist/Artalk.js"
         data-artalk-css="https://cdn.jsdelivr.net/npm/artalk/dist/Artalk.css"
         data-artalk-server="<%= artalkConfig.server %>"
         data-artalk-site="<%= artalkConfig.site %>">
        <p data-comment-status role="status" aria-live="polite"><%= __('comments_loading') %></p>
        <button type="button" data-comment-retry hidden class="my-2 rounded-lg border border-rd-gray-alpha-400 px-4 py-2"><%= __('comments_retry') %></button>
        <div data-comment-mount><div id="artalk-comment"></div></div>
    </div>
<% } %>
