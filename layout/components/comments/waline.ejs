<% const walineConfig = theme.comment.config?.waline || {}; %>
<% if (theme.comment.system === 'waline' && walineConfig.serverUrl && walineConfig.lang) { %>
    <%
      const walineOptions = {
        serverURL: walineConfig.serverUrl,
        dark: 'body[class~="dark-mode"]',
        reaction: Array.isArray(walineConfig.reaction) && walineConfig.reaction.length
          ? walineConfig.reaction
          : Boolean(walineConfig.reaction),
        requiredMeta: ['nick', 'mail'],
        emoji: Array.isArray(walineConfig.emoji) ? walineConfig.emoji : [],
      };
      for (const key of ['lang', 'locale', 'login', 'wordLimit', 'pageSize', 'commentSorting', 'meta', 'recaptchaV3Key', 'turnstileKey']) {
        const value = walineConfig[key];
        if (value !== undefined && value !== null && value !== '') {
          walineOptions[key] = value;
        }
      }
    %>
    <div class="waline-container min-h-16" data-waline data-comment-provider="waline"
         data-waline-config="<%= JSON.stringify(walineOptions) %>">
        <p data-comment-status role="status" aria-live="polite"><%= __('comments_loading') %></p>
        <button type="button" data-comment-retry hidden class="my-2 rounded-lg border border-rd-gray-alpha-400 px-4 py-2"><%= __('comments_retry') %></button>
        <div data-comment-mount><div id="waline"></div></div>
    </div>
<% } %>
