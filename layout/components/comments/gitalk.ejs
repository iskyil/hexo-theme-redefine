<% const gitalkConfig = theme.comment.config?.gitalk || {}; %>
<% if (
        theme.comment.system === 'gitalk'
        && gitalkConfig.clientID
        && gitalkConfig.clientSecret
        && gitalkConfig.owner
        && gitalkConfig.repo
) { %>
    <div class="gitalk-container min-h-16" data-gitalk data-comment-provider="gitalk"
         data-gitalk-src="https://cdnjs.cloudflare.com/ajax/libs/gitalk/1.8.0/gitalk.min.js"
         data-gitalk-client-id="<%= gitalkConfig.clientID %>"
         data-gitalk-client-secret="<%= gitalkConfig.clientSecret %>"
         data-gitalk-repo="<%= gitalkConfig.repo %>"
         data-gitalk-owner="<%= gitalkConfig.owner %>"
         data-gitalk-language="<%= config.language || '' %>"
         data-gitalk-proxy="<%= gitalkConfig.proxy || 'https://github.com/login/oauth/access_token' %>">
        <p data-comment-status role="status" aria-live="polite"><%= __('comments_loading') %></p>
        <button type="button" data-comment-retry hidden class="my-2 rounded-lg border border-rd-gray-alpha-400 px-4 py-2"><%= __('comments_retry') %></button>
        <div data-comment-mount><div id="gitalk-container"></div></div>
    </div>
<% } %>
