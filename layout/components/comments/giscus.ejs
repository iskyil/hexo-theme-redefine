<% const giscusConfig = theme.comment.config?.giscus || {}; %>
<% if (
        theme.comment.system === 'giscus' &&
        giscusConfig.repo &&
        giscusConfig.repo_id &&
        giscusConfig.category_id
    ) { %>
    <%
      const flag = (val, fallback) =>
        val === undefined || val === null || val === ''
          ? fallback
          : val === true || val === 1 || val === '1'
            ? '1'
            : '0';
    %>
    <div class="giscus-container min-h-16" data-giscus data-comment-provider="giscus"
         data-giscus-src="https://giscus.app/client.js"
         data-giscus-repo="<%= giscusConfig.repo %>"
         data-giscus-repo-id="<%= giscusConfig.repo_id %>"
         data-giscus-category="<%= giscusConfig.category ?? '' %>"
         data-giscus-category-id="<%= giscusConfig.category_id %>"
         data-giscus-mapping="<%= giscusConfig.mapping || 'pathname' %>"
         data-giscus-strict="<%= flag(giscusConfig.strict, '0') %>"
         data-giscus-reactions-enabled="<%= flag(giscusConfig.reactions_enabled, '1') %>"
         data-giscus-emit-metadata="<%= flag(giscusConfig.emit_metadata, '0') %>"
         data-giscus-lang="<%= giscusConfig.lang || 'en' %>"
         data-giscus-input-position="<%= giscusConfig.input_position || 'bottom' %>"
         data-giscus-loading="<%= giscusConfig.loading || 'lazy' %>">
        <p data-comment-status role="status" aria-live="polite"><%= __('comments_loading') %></p>
        <button type="button" data-comment-retry hidden class="my-2 rounded-lg border border-rd-gray-alpha-400 px-4 py-2"><%= __('comments_retry') %></button>
        <div data-comment-mount><div id="giscus-container"></div></div>
    </div>
<% } %>
