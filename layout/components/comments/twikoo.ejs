<% const twikooConfig = theme.comment.config?.twikoo || {}; %>
<% if (theme.comment.system === 'twikoo' && twikooConfig.server_url) { %>
    <div class="twikoo-container min-h-16" data-twikoo data-comment-provider="twikoo"
         data-twikoo-src="https://cdnjs.cloudflare.com/ajax/libs/twikoo/<%= twikooConfig.version || '1.6.10' %>/twikoo.all.min.js"
         data-twikoo-env="<%= twikooConfig.server_url %>"
         data-twikoo-region="<%= twikooConfig.region || '' %>">
        <p data-comment-status role="status" aria-live="polite"><%= __('comments_loading') %></p>
        <button type="button" data-comment-retry hidden class="my-2 rounded-lg border border-rd-gray-alpha-400 px-4 py-2"><%= __('comments_retry') %></button>
        <div data-twikoo-mount><div id="twikoo-comment"></div></div>
    </div>
<% } %>
